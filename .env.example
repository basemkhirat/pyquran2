# Backend variables

# Path to the Hugging Face Whisper model for speech-to-text.
HF_MODEL_PATH=./models/whisper-quran-v1
# HF_MODEL_PATH=./models/tarbiyah-ai-v1-1

# Path to Hafs narration JSON: reference Quran text used for scoring and correction.
HAFS_JSON_PATH=./assets/narrations/hafs.json

# Weight for character-level score (0–1). Applies to BOTH the text score and the acoustic
# (wav2vec2) score: score = WEIGHT_CHAR * char_score + WEIGHT_DIACRITIC * diacritic_score.
WEIGHT_CHAR=0.75

# Weight for diacritic (tashkeel) score (0–1). WEIGHT_CHAR + WEIGHT_DIACRITIC should sum to
# 1.0 so each blended score stays in [0, 1].
WEIGHT_DIACRITIC=0.25

# Which diacritics count toward the diacritic score (and are kept during acoustic scoring).
# Set any to false to ignore that mark everywhere. All default to true.
SCORE_FATHA=true
SCORE_DAMMA=true
SCORE_KASRA=true
SCORE_SHADDA=true
SCORE_SUKOON=true

# Minimum total score (0–1) for a segment to be marked correct; below this is incorrect.
SCORE_THRESHOLD=0.5

# When true, mark word correct if EITHER text_score OR acoustic_score exceeds SCORE_THRESHOLD (default: false).
PASS_ON_ANY_SCORE=true

# Fallback for start_session's `record` field, used only when the client does not send it.
# When enabled, sessions are persisted to data/sessions/{uuid}/ as info.json + recording.wav.
SAVE_SESSION_DATA=false

# Where recorded sessions are stored. On Modal this points at a mounted Volume (/data/sessions).
SESSIONS_DIR=./data/sessions

# Milliseconds of silence after speech before ending the current recording segment (VAD).
SILENCE_TIMEOUT_MS=50

# Sample rate (Hz) for recording and processing audio; 16000 is standard for Whisper.
AUDIO_SAMPLE_RATE=16000

# Max Levenshtein edits allowed to auto-correct a transcribed word to the expected word; above this, transcription is kept.
MAX_EDITS_FOR_CORRECTION=1

# text scorer (whisper transcription)
ENABLE_TEXT_SCORE=true
WEIGHT_TEXT=0.2

# acoustic scorer
ENABLE_ACOUSTIC_SCORE=true
WEIGHT_ACOUSTIC=0.8
#WAV2VEC2_QURAN_ASR_MODEL=HamzaSidhu786/wav2vec2-base-word-by-word-quran-asr
#WAV2VEC2_QURAN_ASR_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-arabic
WAV2VEC2_QURAN_ASR_MODEL=rabah2026/wav2vec2-large-xlsr-53-arabic-quran-v_final

# --- Acoustic backend -------------------------------------------------------------------
# Each session picks its model in start_session's `model` field ("wav2vec2" | "muaalem").
# ACOUSTIC_BACKEND is only the default for clients that send nothing. Backends load lazily
# and are cached, so a deployment that never selects muaalem never downloads its weights.
ACOUSTIC_BACKEND=wav2vec2

# --- Muaalem (obadx/muaalem-model-v3_2): phonemes + tajweed/tashkeel error detection ------
MUAALEM_MODEL=obadx/muaalem-model-v3_2
# Empty = auto ("cuda" when available, else "cpu"). Muaalem is impractically slow on CPU.
MUAALEM_DEVICE=
# Empty = bfloat16 on cuda, float32 on cpu (CPU bf16 kernels are slow/incomplete).
MUAALEM_DTYPE=
# How much a word's tajweed accuracy pulls its total score. 0 (default) surfaces tajweed
# errors in the UI without failing the word — wav2vec2 cannot detect tajweed at all, so
# gating on it would drop pass rates for unchanged recitation.
MUAALEM_WEIGHT_TAJWEED=0.0
# Muaalem's scores come from discrete errors rather than a smooth CER blend, so its
# distribution is more bimodal and it gets its own cutoff instead of SCORE_THRESHOLD.
MUAALEM_SCORE_THRESHOLD=0.76
# Continuous mode, both backends: how many consecutive low-confidence words may be bridged
# while looking for a nearby resync anchor. Stops one distant false match cascading the cursor
# and failing a run of words the reciter never reached. (The old
# MUAALEM_CONTINUOUS_MAX_UNANCHORED_WORDS name is still read as a fallback.)
CONTINUOUS_MAX_UNANCHORED_WORDS=2
# Extra words phonetized past the scored chunk to absorb the phonetizer's end-of-text waqf
# (pause) rules, so the last scored word isn't judged against a pause it never made.
MUAALEM_CONTEXT_PAD_WORDS=5
# Phoneme strings are longer and finer-grained than the Arabic letters
# VERSE_DETECTION_THRESHOLD was calibrated for, so detection gets its own cutoff too.
MUAALEM_VERSE_DETECTION_THRESHOLD=0.6

# --- Moshaf (recitation style) attributes, passed to quran_transcript.quran_phonetizer ----
# These decide what counts as correct, so they must match how the reciter actually recites.
MOSHAF_REWAYA=hafs
MOSHAF_MADD_MONFASEL_LEN=2
MOSHAF_MADD_MOTTASEL_LEN=4
MOSHAF_MADD_MOTTASEL_WAQF=4
# Must be 4 or 6 — validated at startup. quran_transcript derives madd_alleen_len from this
# and has no phoneme tags for a 2-count leen madd, so 2 raises KeyError deep inside the
# phonetizer on any madd-al-leen word. (The upstream docs example uses 2.)
MOSHAF_MADD_AARED_LEN=4

# When set, socket connections require this key in handshake auth.api_key.
SOCKET_AUTH_API_KEY=mWrhEBxIUstdokyV5FynGaqN0zowUYaCFvW88RdzYeY

# When set, the frontend shows a password gate and validates it server-side via POST /api/login.
# Leave empty to disable the gate.
APP_PASSWORD=

# Interval in ms between streaming transcription runs during speech.
STREAMING_INTERVAL_MS=1500
# Minimum audio buffer (seconds) before first streaming transcription.
STREAMING_MIN_AUDIO_SEC=0.8

# --- Verse detection (which verse the user starts reciting) ---
# Minimum alignment score (0–1) to confirm a start verse.
VERSE_DETECTION_THRESHOLD=0.6
# Upper cap on words compared when the utterance is long (short utterances use their own length).
VERSE_DETECTION_WORD_COUNT=3
# Candidates within this score margin of the best are treated as a tie. When identical verses
# (e.g. Al-Rahman's refrain) tie, detection stays "ambiguous" and waits for the next distinct
# verse instead of guessing the wrong occurrence.
VERSE_DETECTION_TIE_EPSILON=0.05

# --- Public URL ---
# Public origin used to build absolute URLs in socket payloads (e.g. the recording_url in
# session_ended), such as https://api.example.com. Leave empty to derive it from the client's
# handshake headers, which is correct for most deployments including behind a proxy that
# sets X-Forwarded-Proto / X-Forwarded-Host.
PUBLIC_BASE_URL=

HF_TOKEN=